# The only key the site needs: a FREE Google Gemini key from https://aistudio.google.com/apikey
# It powers the troubleshooter, Section Studio and the Ask Lens assistant. Never commit the real value.
GEMINI_API_KEY=

# Optional model overrides (all default to free-tier Gemini models)
# ANALYZE_MODEL=gemini-3.8-flash
# THEME_FREE_MODEL=gemini-3.5-flash-lite
# THEME_PRO_MODEL=gemini-3.8-flash
# CHAT_MODEL=gemini-3.5-flash-lite

# Optional: use any other OpenAI-compatible provider instead (e.g. Groq, OpenRouter)
# CHAT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_API_KEY=

# Optional: a long random string used to sign visitors' token balances
# WALLET_SECRET=
