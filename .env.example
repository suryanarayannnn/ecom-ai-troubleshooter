# Diagnostic agent: get a key at https://console.anthropic.com (never commit the real value)
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# "Ask Lens" chat assistant: free Gemini key from https://aistudio.google.com/apikey
# Without it, the assistant still answers common questions offline.
GEMINI_API_KEY=
# Optional: any OpenAI-compatible endpoint/model (e.g. Groq, OpenRouter)
# CHAT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_MODEL=gemini-3.5-flash-lite
# CHAT_API_KEY=
